<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="tbl|+TBL-DEPARTMENT|1.1.1|pa" author="Peyman Azish">
        <createTable tableName="TBL_DEPARTMENT">
            <column name="ID" type="number(19,0)">
                <constraints primaryKey="true" nullable="false" primaryKeyName="TBL_DEPARTMENT_PK"/>
            </column>
            <column name="NAME" type="varchar(100 CHAR)"  >
                <constraints nullable="false" />
            </column>
            <column name="code" type="varchar(30 CHAR)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_DEPARTMENT_CODE"/>
            </column>
            <column name="active" type="number(1,0)" defaultValueNumeric="1" >
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>