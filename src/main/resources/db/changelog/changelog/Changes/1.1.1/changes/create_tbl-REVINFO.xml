<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="+TBL| REVINFO | 1.1.1| PA" author="PEYMAN AZISH">
        <createSequence sequenceName="REVISION_GENERATOR" startValue="1" incrementBy="1"/>
        <createTable tableName="REVINFO">
            <column name="REV" type="number(19,0)">
                <constraints primaryKey="true" primaryKeyName="PK_REVINFO"/>
            </column>
            <column name="REVTSTMP" type="number(19,0)">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>
</databaseChangeLog>