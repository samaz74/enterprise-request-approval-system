<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="+TBL | TBL_PURCHASE_REQUEST | 1.1.1 | PA" author="peyman Azish">
        <createTable tableName="tbl_purchase_request">
            <column name="id"  type="number(19,0)">
                <constraints primaryKey="true" primaryKeyName="PK_purchase_request"/>
            </column>
            <column name="title" type="varchar2(200)" >
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR2(2000 CHAR)">
                <constraints nullable="true"/>
            </column>
            <column name="requester_id" type="number(19,0)" >
                <constraints foreignKeyName="FK_REQUESTER_ID" nullable="false" referencedTableName="tbl_employee" referencedColumnNames="id"/>
            </column>
            <column name="approver_id" type="number(19,0)">
                <constraints foreignKeyName="FK_APPROVER_ID" referencedTableName="tbl_employee" referencedColumnNames="id"/>
            </column>
            <column name="status" type="varchar(25 CHAR)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="timestamp(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp(6)">
                <constraints nullable="true"/>
            </column>
            <column name="version" type="number(19,0)">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>
</databaseChangeLog>