<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="TBL |+TBL_EMPLOYEE|  1.1.1 | PA" author="PEYMAN AZISH">
        <createTable tableName="tbl_employee">
            <column name="id" type="number(19,0)">
                <constraints primaryKey="true" primaryKeyName="PK_EMPLOYEE_ID" nullable="false"/>
            </column>
            <column name="full_name" type="varchar2(150 CHAR)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar2 (150 CHAR)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UK_EMAPLOYEE_EMAIL"/>
            </column>
            <column name="department_id" type="number(19,0)" >
                <constraints nullable="false" foreignKeyName="FK_DEPARTMENT_ID" references="TBL_DEPARTMENT(ID)"/>
            </column>
            <column name="active" type="number(1,0)" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>
</databaseChangeLog>